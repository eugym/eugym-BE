    "@types/uuid": "^10.0.0",
    "@types/speakeasy": "^2.0.10",
    "@types/qrcode": "^1.5.5",
    "@types/compression": "^1.7.5",
    "@types/node": "^20.14.2",
    "tsx": "^4.15.6",
