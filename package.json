    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.3.1",
    "morgan": "^1.10.0",
    "dotenv": "^16.4.5",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "node-cron": "^3.0.3",
    "uuid": "^10.0.0",
    "speakeasy": "^2.0.0",
