# ─────────────────────────────────────────────────────────────────────────────
# Eugym API — environment
#
# Copy to .env and fill in. Every value here is validated at boot by
# src/config/env.ts; the process exits rather than starting half-configured, so
# a missing required value fails fast and loudly.
#
# REQUIRED  — no default. The service will not start without it.
# optional  — has a default; listed with the default shown.
#
# .env is gitignored. Never commit real values — put production secrets into
# the Render dashboard, not into a file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
# optional — development | production | test
NODE_ENV=development
# optional — 4000. Render supplies this; leave unset there.
PORT=4000
# optional — /api/v1. The frontend's NEXT_PUBLIC_API_URL must include this.
API_PREFIX=/api/v1

# ── Database ─────────────────────────────────────────────────────────────────
# Supabase: use the Session pooler (IPv4, port 5432), not the direct host
# (IPv6-only) and not the transaction pooler on 6543, which recycles
# connections between statements and breaks session state.
#
#   DB_HOST=aws-0-<region>.pooler.supabase.com
#   DB_USER=postgres.<project-ref>
#   DB_NAME=postgres
#
# optional — localhost
DB_HOST=localhost
# optional — 5432
DB_PORT=5432
# REQUIRED
DB_NAME=eugym_db
# REQUIRED
DB_USER=eugym_user
# REQUIRED
DB_PASSWORD=
# optional — false. Supabase requires true.
DB_SSL=false
# optional — 2
DB_POOL_MIN=2
# optional — 10. Drop to ~5 on pooled/free tiers, which cap connections.
DB_POOL_MAX=10

# ── Auth ─────────────────────────────────────────────────────────────────────
# Both REQUIRED, minimum 32 characters, and must differ from each other.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# optional — 15m
JWT_ACCESS_EXPIRES=15m
# optional — 7d
JWT_REFRESH_EXPIRES=7d
# optional — 12
BCRYPT_ROUNDS=12
# optional — 10 requests per minute on auth routes
AUTH_RATE_LIMIT=10

# Ships false so a dead mailer cannot lock every new user out. Set true in
# production once SMTP is confirmed working — otherwise unverified addresses
# can sign in.
REQUIRE_EMAIL_VERIFICATION=false

# ── Payments (Paystack) ──────────────────────────────────────────────────────
# All three REQUIRED. sk_test_/pk_test_ for development, sk_live_/pk_live_ in
# production. The webhook secret comes from the Paystack dashboard after you
# register the endpoint:
#   https://<api-host>/api/v1/subscriptions/webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ── Email ────────────────────────────────────────────────────────────────────
# Carries email verification, password reset, and admin-created account
# activation — none of those flows work without it.
#
# Port 465 connects over implicit TLS; anything else uses STARTTLS.
# Verify your sending domain and add SPF + DKIM, or this mail lands in spam.
#
# optional — smtp.sendgrid.net
SMTP_HOST=smtp.sendgrid.net
# optional — 587
SMTP_PORT=587
# REQUIRED
SMTP_USER=
# REQUIRED
SMTP_PASS=
# optional — noreply@eugym.ng. Must be on a domain you have verified.
EMAIL_FROM=noreply@eugym.ng
# optional — Eugym Fitness
EMAIL_FROM_NAME=Eugym Fitness

# ── URLs and origins ─────────────────────────────────────────────────────────
# FRONTEND_URL builds the links inside outgoing mail. Left on localhost in
# production, every verification, reset and activation link points at a machine
# the recipient does not have.
# optional — http://localhost:3000
FRONTEND_URL=http://localhost:3000

# CORS allow-list, comma separated. Most dashboard traffic is same-origin
# through the Next proxy routes, but a few hooks call the API straight from the
# browser and are blocked without this. Vercel preview deploys get unique URLs
# and need adding explicitly if you rely on them.
# optional — http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ── Business rules ───────────────────────────────────────────────────────────
# optional — 10000 (₦10,000 per affiliate visit, used for monthly settlements)
AFFILIATE_RATE_PER_VISIT=10000
# optional — Eugym Fitness. Shown in authenticator apps for 2FA.
TWO_FA_APP_NAME=Eugym Fitness

# ── Observability ────────────────────────────────────────────────────────────
# optional — debug. Use info in production.
LOG_LEVEL=debug

# ── Uploads (not wired up) ───────────────────────────────────────────────────
# multer and Cloudinary are in package.json but never imported — image fields
# accept URLs only. Leave blank until an upload pipeline exists.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
